# Semgravio admin-web 前端容器 nginx 站点配置（#94）。
# __BACKEND_URL__ 由容器启动脚本（deploy/docker-entrypoint.d/30-backend-url.sh）替换为
# 后端源站地址（如 http://semgravio-admin:8081），替换前必须为空值/占位校验通过。
server {
    listen       80;
    server_name  _;

    root   /usr/share/nginx/html;
    index  index.html;

    gzip            on;
    gzip_comp_level 5;
    gzip_min_length 1k;
    gzip_types      text/css application/javascript application/json image/svg+xml;

    # 静态资源（vite 产物，文件名带内容哈希）：缺失直接 404，
    # 不被 SPA 回退吞成 200 的 index.html（否则旧资源缺失会拿到 HTML，报含糊的 JS 错）。
    location /assets/ {
        try_files $uri =404;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    location = /api/admin {
        return 404;
    }

    # admin BFF 同源反代。
    # BACKEND_URL 是后端源站口径，不含 /api/admin；
    # proxy_pass 使用变量且不带 URI 部分 → nginx 原样转发完整原始请求 URI（前缀不丢不重）。
    # 变量上游必须配 resolver：Docker 内嵌 DNS（127.0.0.11），上游容器重建后自动重新解析。
    location /api/admin/ {
        resolver 127.0.0.11 valid=10s ipv6=off;

        set $backend_upstream "__BACKEND_URL__";
        proxy_pass $backend_upstream;

        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA history 路由：根路径与非根路由均回退到应用入口 index.html。
    location / {
        try_files $uri $uri/ /index.html;
    }
}
